SANDBOX_WORKER_TOKEN=replace-with-at-least-24-random-characters
SANDBOX_ENGINE=docker
SANDBOX_REGISTRY_NETWORK=multi-agent-registry
SANDBOX_NPM_REGISTRY_URL=http://npm-registry:4873/
SANDBOX_READ_ONLY_ROOT=true
SANDBOX_REQUIRE_PINNED_IMAGES=false
# For stronger production pinning, replace tags with immutable digests and set the flag above to true.
SANDBOX_NODE_IMAGE=node:20-alpine
SANDBOX_BROWSER_IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble
PORT=4040
